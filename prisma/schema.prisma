generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  AUTHOR
  ADMIN
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_AUTHOR
  RESOLVED
  CLOSED
}

enum TicketPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum TicketCategory {
  ROYALTY
  DISTRIBUTION
  PRINTING
  ISBN
  ACCOUNT
  GENERAL
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(AUTHOR)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author          Author?
  assignedTickets SupportTicket[] @relation("AssignedAdmin")
  replies         TicketReply[]
  internalNotes   InternalNote[]  @relation("AdminInternalNotes")

  @@index([role])
}

model Author {
  id         String   @id @default(cuid())
  userId     String   @unique
  authorCode String?  @unique
  phone      String?
  city       String?
  joinedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  books   Book[]
  tickets SupportTicket[]
}

model Book {
  id                    String   @id @default(cuid())
  authorId              String
  bookCode              String?  @unique
  title                 String
  isbn                  String?  @unique
  genre                 String?
  publicationDate       DateTime?
  status                String   @default("Unknown")
  mrp                   Decimal? @db.Decimal(10, 2)
  packageName           String?
  royaltyRate           Float?
  royaltyPerCopy        Decimal? @db.Decimal(10, 2)
  totalCopiesSold       Int      @default(0)
  totalRoyalties        Float    @default(0)
  royaltyPaid           Decimal  @default(0) @db.Decimal(12, 2)
  royaltyPending        Decimal  @default(0) @db.Decimal(12, 2)
  lastRoyaltyPayoutDate DateTime?
  printPartner          String?
  availableOn           String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  Author          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tickets SupportTicket[]

  @@index([authorId])
  @@index([title])
}

model SupportTicket {
  id          String         @id @default(cuid())
  authorId    String
  bookId      String?
  assignedTo  String?

  subject     String
  description String

  category TicketCategory @default(GENERAL)
  priority TicketPriority @default(MEDIUM)
  status   TicketStatus   @default(OPEN)

  // AI classification and suggested response
  aiCategory          String?
  aiPriority          String?
  aiSuggestedResponse String?
  aiConfidence        Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author      Author            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  book        Book?             @relation(fields: [bookId], references: [id], onDelete: SetNull)
  admin       User?             @relation("AssignedAdmin", fields: [assignedTo], references: [id], onDelete: SetNull)
  replies     TicketReply[]
  attachments TicketAttachment[]
  notes       InternalNote[]

  @@index([authorId])
  @@index([bookId])
  @@index([assignedTo])
  @@index([status, priority])
  @@index([category])
  @@index([createdAt])
}

model TicketReply {
  id         String   @id @default(cuid())
  ticketId   String
  userId     String
  message    String
  isInternal Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([userId])
}

model TicketAttachment {
  id        String   @id @default(cuid())
  ticketId  String
  fileName  String
  fileUrl   String
  mimeType  String?
  fileSize  Int?

  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model InternalNote {
  id        String   @id @default(cuid())
  ticketId  String
  adminId   String
  content   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  admin  User          @relation("AdminInternalNotes", fields: [adminId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([adminId])
}